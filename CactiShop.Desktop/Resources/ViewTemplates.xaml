<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:CactiShop.Desktop.ViewModels"
                    xmlns:views="clr-namespace:CactiShop.Desktop.Views">

    <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
        <views:CatalogView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:ProductDetailsViewModel}">
        <views:ProductDetailsView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <views:LoginView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
        <views:RegisterView/>
    </DataTemplate>

</ResourceDictionary>

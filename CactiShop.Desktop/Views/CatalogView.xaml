<UserControl x:Class="CactiShop.Desktop.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CactiShop.Desktop.Views"
             xmlns:vm="clr-namespace:CactiShop.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Поиск по названию" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="240" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Сортировка" Style="{StaticResource FieldLabel}"/>
                <ComboBox Width="180" 
                          ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <TextBlock Text="Цена от, ₽" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="90" Text="{Binding MinPriceText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <TextBlock Text="до, ₽" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="90" Text="{Binding MaxPriceText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8">
                <Button Content="Найти" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
                <Button Content="Сбросить" Style="{StaticResource GhostButton}" Command="{Binding ResetFiltersCommand}"/>
            </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="1">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Style="{StaticResource DangerBadge}" Margin="0,0,0,12" HorizontalAlignment="Left"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="Ничего не найдено. Попробуйте изменить фильтры." Style="{StaticResource MutedText}" FontSize="14"
                       Margin="0,0,0,12" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Width="220"
                                Margin="0,0,12,12"
                                Command="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <Grid Height="140" Margin="0,0,0,10">
                                    <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrl}}"
                                           Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CategoryName}" Style="{StaticResource MutedText}" Margin="0,2,0,8"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                               Text="{Binding AverageRating, StringFormat='★ {0:0.0}', TargetNullValue='Нет оценок'}"/>
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Price, StringFormat='{}{0:N2} ₽'}" />
                                </DockPanel>
                                <Border Style="{StaticResource DangerBadge}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Visibility="{Binding CanBuy, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="Нет в наличии" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

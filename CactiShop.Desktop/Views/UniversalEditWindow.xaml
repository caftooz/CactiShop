<Window x:Class="CactiShop.Desktop.Views.UniversalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CactiShop.Desktop.Views"
        mc:Ignorable="d"
        Title="Редактирование" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsContainer"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="Удалить" Width="80" Margin="0,0,10,0" Background="Red"/>
            <Button x:Name="SaveButton" Content="Сохранить" Width="80" Margin="0,0,10,0" Background="LawnGreen"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="80" Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Window>

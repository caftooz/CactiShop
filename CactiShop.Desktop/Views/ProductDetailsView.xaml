<UserControl x:Class="CactiShop.Desktop.Views.ProductDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CactiShop.Desktop.Views"
             xmlns:vm="clr-namespace:CactiShop.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProductDetailsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Button Content="← Назад к каталогу" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}" Margin="0,0,0,12" />

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Style="{StaticResource DangerBadge}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" />
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20"
                    Visibility="{Binding Product, Converter={StaticResource NotNullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Height="280" VerticalAlignment="Top">
                        <Image Source="{Binding Product.Item.ImageUrl, Converter={StaticResource ImageUrl}}" Stretch="Uniform" />
                    </Grid>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Product.Item.CategoryName}" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Product.Item.Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Product.Item.AverageRating, StringFormat='★ {0:0.0}', TargetNullValue='Нет оценок'}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Product.Item.ReviewsCount, StringFormat='Отзывов: {0}'}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding Product.Item.Price, StringFormat='{}{0:N2} ₽'}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{Binding Product.Item.StockQuantity, StringFormat='На складе: {0}'}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                        <Border Style="{StaticResource DangerBadge}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Visibility="{Binding Product.Item.CanBuy, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Сейчас купить нельзя: товара нет на складе или он недоступен"
                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,20,0,4" />
                        <TextBlock Text="{Binding Product.Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

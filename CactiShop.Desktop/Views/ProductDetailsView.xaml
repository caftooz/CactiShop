<UserControl x:Class="CactiShop.Desktop.Views.ProductDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CactiShop.Desktop.Views"
             xmlns:vm="clr-namespace:CactiShop.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProductDetailsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Button Content="← Назад к каталогу" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}" Margin="0,0,0,12" />

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Style="{StaticResource DangerBadge}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" />
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource MultiBoolAndNotBoolToVisibility}">
                        <Binding Path="HasModel" />
                        <Binding Path="IsBusy" />
                    </MultiBinding>
                </Border.Visibility>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Height="280" VerticalAlignment="Top">
                        <Image Source="{Binding Image, TargetNullValue={StaticResource NoImage}}"
                               Stretch="Uniform" />
                    </Grid>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding AvgRatingText}" Margin="0,0,12,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding PriceText}" FontSize="28" FontWeight="Bold" />

                        <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,20,0,4" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        <Button Content="В корзину" Visibility="{Binding HasInCart, Converter={StaticResource InverseBoolToVisibility}}"
        Command="{Binding AddToCartCommand}"/>
                        <Grid Visibility="{Binding HasInCart, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="-" Command="{Binding DecreaseQuantityCommand}"/>
                            <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="+" Command="{Binding IncreaseQuantityCommand}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
